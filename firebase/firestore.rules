rules_version = '2';

// Hearth sitter links. Each document is an encrypted copy of a few handbook pages; the key is only
// in the link the family sends, so the database can't read it. Paste this into Firestore > Rules.
//
// Also set a TTL policy (Firestore > TTL) on collection group `links`, field `expiresAt`, so copies
// are deleted after they end. (The link page also refuses an ended link straight away.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /links/{linkId} {
      // Opening a link: only someone who already has its long random id. No listing all links.
      allow get: if true;
      allow list: if false;

      // Making a link: exactly the expected fields, a sensible size, and an end within 8 days.
      allow create: if linkId.size() >= 20
        && request.resource.data.keys().hasOnly(['v', 'data', 'iv', 'expiresAt', 'createdAt'])
        && request.resource.data.v == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() < 400000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() < 64
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');

      // "Stop link": whoever has the id (the family who made it, or the sitter) can delete it.
      allow delete: if true;

      allow update: if false;
    }
  }
}
