# Copy this file to .env and fill it in from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# These values identify the project; they aren't secret (the security rules protect the data).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the sitter link page (the viewer/ folder) is hosted on Vercel, e.g. https://hearth-link.vercel.app
EXPO_PUBLIC_SITTER_VIEWER_URL=
