{
  "expo": {
    "name": "Left in Love",
    "slug": "left-in-love",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leftinlove",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.thehatch3tt.leftinlove",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B1922",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thehatch3tt.leftinlove"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15141B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Left in Love lets you add photos to your handbook pages.",
          "cameraPermission": "Left in Love lets you take photos for your handbook pages."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Left in Love uses Face ID to keep your handbook private."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#15141B",
    "owner": "thehatch3tt",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "166a7f99-96d0-4e3f-9749-72a8698a4289"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/166a7f99-96d0-4e3f-9749-72a8698a4289"
    }
  }
}
